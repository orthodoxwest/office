<?xml version="1.0" encoding="utf-8"?>
<!-- The widget one row high: the day's colour, the feast, and the invitation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/widget_day"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_lozenge"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_lozenge" />

        <TextView
            android:id="@+id/widget_feast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/junicode_regular"
            android:maxLines="1"
            android:text="@string/widget_preview_feast"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_pray"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_invitation"
        android:fontFamily="@font/junicode_regular"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/widget_preview_pray"
        android:textColor="@color/widget_accent"
        android:textSize="15sp" />
</LinearLayout>
