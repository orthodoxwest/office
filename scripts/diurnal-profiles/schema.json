{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diurnal extraction profile",
  "type": "object",
  "properties": {
    "default_hour": { "type": "string" },
    "page_aliases": { "$ref": "#/$defs/mappings" },
    "heading_aliases": { "$ref": "#/$defs/mappings" },
    "slot_aliases": { "$ref": "#/$defs/mappings" }
  },
  "additionalProperties": false,
  "$defs": {
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern"],
        "properties": {
          "pattern": { "type": "string" },
          "owner": { "type": "string" },
          "slot": { "type": "string" },
          "hour": { "type": "string" },
          "variant": { "type": "string" },
          "title": { "type": "string" },
          "printed_page": { "type": "string" },
          "confidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
